# GEMINI_API_KEY: Required for Gemini AI API calls and natural language planning.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this web dashboard is hosted.
APP_URL="MY_APP_URL"

# PORT: Local development server port (defaults to 3000)
PORT="3000"

# BOT_RUNTIME_URL: (Optional) URL to persistent Mineflayer daemon (e.g. http://localhost:4000 or https://mcc-daemon.up.railway.app)
# If left blank, the dashboard seamlessly operates in high-fidelity interactive DEMO / MOCK MODE.
BOT_RUNTIME_URL=""

# BOT_API_KEY: (Optional) Shared secret Bearer token configured on the persistent Mineflayer daemon
BOT_API_KEY=""

# MC_HOST: Default Minecraft server host (e.g. mc.hypixel.net)
MC_HOST="mc.hypixel.net"

# MC_PORT: Default Minecraft server port (defaults to 25565)
MC_PORT="25565"
