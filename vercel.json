{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/server/test-ping",
      "destination": "/api/server/test-ping.js"
    },
    {
      "source": "/api/ai/plan",
      "destination": "/api/ai/plan.js"
    },
    {
      "source": "/api/bot/state",
      "destination": "/api/bot/state.js"
    },
    {
      "source": "/api/bot/connect",
      "destination": "/api/bot/connect.js"
    },
    {
      "source": "/api/bot/disconnect",
      "destination": "/api/bot/disconnect.js"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
